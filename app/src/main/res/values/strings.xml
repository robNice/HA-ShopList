    <string name="help_notifications_title">Notifications</string>
    <string name="help_notifications_text">Enable notifications so the app can react to changes from Home Assistant in the background. Disable this if you do not want reminders or background updates.</string>
    <string name="help_ha_url_title">Home Assistant URL</string>
    <string name="help_ha_url_text">Enter the full address of your Home Assistant instance, including https:// or http:// and an optional port. Example: https://homeassistant.local:8123</string>
    <string name="help_token_title">Long-lived access token</string>
    <string name="help_token_text">1. Open your profile in Home Assistant.\n2. Open the Security tab.\n3. Scroll down to Long-lived access tokens.\n4. Create a new token.\n5. Copy the token immediately and paste it here.\n\nThe token is shown only once and is required so the app can securely load and update your shopping list.</string>
    <string name="help_list_selection_title">List selection</string>
    <string name="help_list_selection_text">Choose which Home Assistant todo list this app should use. Lists are only loaded after a valid URL and token have been entered.</string>
    <string name="help_area_visibility_title">Store sections</string>
    <string name="help_area_visibility_text">Enable only the store sections you want to use in the section dropdowns. Disabled sections are hidden from dropdowns for new or edited items, but still remain visible in the shopping list when existing items already use them.\n\nYou can create a separate category setup for each store. The selection above the list only chooses which store you are editing here. As soon as there are at least two stores, you choose the store for the shopping list on the main screen.</string>
    <string name="help_product_history_title">Product history</string>
    <string name="help_product_history_text">The app stores previously used product names on this device to offer autocomplete when you add new items. Clearing the history removes these local suggestions.</string>
    <string name="help_list_display_mode_title">List display</string>
    <string name="help_list_display_mode_text">Simple shows all items in one list. Categorized groups items by store section in the order set below.</string>
    <string name="help_backup_title">Backup and restore</string>
    <string name="help_backup_text">Exports the selected data (connection, category settings, product history) to a password-encrypted file. When restoring, you choose which parts of the backup to import. The password is not stored – without it, the backup cannot be opened.</string>
    <string name="help_updates_title">Updates</string>
    <string name="help_updates_text">This version was not installed via an app store, so the app regularly checks GitHub for new releases. If an update is available, you can download and install it here. Android asks you to confirm the installation.</string>
