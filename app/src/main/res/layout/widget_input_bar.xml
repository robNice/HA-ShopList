<?xml version="1.0" encoding="utf-8"?>
<!--
    Input bar of the widgets as plain RemoteViews: its click intents are mutable, so the launcher
    can add the bounds of the tapped view and the input dialog opens right over the bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_input_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_input_bar_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_input_hint"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:singleLine="true"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/widget_input_area"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/widget_input_area_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_dropdown"
            android:tint="@color/widget_on_surface_variant" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_input_add"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_add_bg">

        <ImageView
            android:id="@+id/widget_input_add_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_add"
            android:tint="@color/widget_on_primary" />
    </FrameLayout>
</LinearLayout>
