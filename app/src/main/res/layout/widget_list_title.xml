<?xml version="1.0" encoding="utf-8"?>
<!-- Switchable list name in the header of the list widget (mutable click intent, see widget_input_bar.xml) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_list_title_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_list"
        android:tint="@color/widget_primary" />

    <TextView
        android:id="@+id/widget_list_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_on_surface"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_dropdown"
        android:tint="@color/widget_on_surface_variant" />
</LinearLayout>
