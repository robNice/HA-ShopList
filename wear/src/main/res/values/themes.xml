<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: shows the app icon until the app is ready, then switches to the normal theme -->
    <style name="Theme.ShopList.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_app_icon</item>
        <item name="postSplashScreenTheme">@android:style/Theme.DeviceDefault</item>
    </style>
</resources>
