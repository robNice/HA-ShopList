<?xml version="1.0" encoding="utf-8"?>
<!--
    The Home Assistant address is entered by the user and is often a local
    http:// address (e.g. http://192.168.1.10:8123). Cleartext is therefore
    allowed. The settings screen warns the user before an http:// URL is used.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
